# ローカル開発用の設定。本番の認証情報は絶対に入れないこと。
# 実際に使う値は .env に置く（.gitignore 済み）。

# データベース
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# ポート
WP_PORT=8080
MAILPIT_PORT=8025

# WordPress サイト設定（bin/setup.sh が使用）
WP_URL=http://localhost:8080
WP_TITLE="pacchi | Backend Engineer"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=contact@pacchi.net

# GitHub API 連携（Phase 6 で使用）
# 未設定でも動作する（未認証は 60 リクエスト/時の制限）
GITHUB_USERNAME=pacchi-dev
GITHUB_TOKEN=
